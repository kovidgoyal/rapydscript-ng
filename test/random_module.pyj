# globals: assrt
from random import randint, randrange, seed


def counts_for(f, lo, hi, n):
    counts = [0 for i in range(hi - lo + 1)]
    for i in range(n):
        v = f()
        assrt.ok(lo <= v and v <= hi, f'{v} is outside [{lo}, {hi}]')
        counts[v - lo] += 1
    return counts


seed(12345)

# Every value in the range should come up, including negative endpoints
for lo, hi in [[1, 6], [-2, 2], [-5, -1], [0, 0], [-3, -3]]:
    counts = counts_for(def (): return randint(lo, hi);, lo, hi, 3000)
    for i in range(len(counts)):
        assrt.ok(counts[i] > 0, f'randint({lo}, {hi}) never returned {lo + i}')

# randint(a, b) should agree with randrange(a, b + 1) for the same seed
seed(54321)
a = [randint(-4, 3) for i in range(200)]
seed(54321)
b = [randrange(-4, 4) for i in range(200)]
assrt.deepEqual(a, b)

# Results must stay integers well past 2**31
for i in range(100):
    v = randint(0, 10 ** 12)
    assrt.ok(0 <= v and v <= 10 ** 12)
    assrt.equal(v, Math.floor(v))

# Invalid arguments
assrt.throws(def (): randint(5, 4);, ValueError)
assrt.throws(def (): randint(0.5, 2);, TypeError)
assrt.throws(def (): randint(0, '3');, TypeError)

# randrange() must handle ranges past 2**31
big = False
for i in range(100):
    v = randrange(10 ** 12)
    assrt.ok(0 <= v and v < 10 ** 12)
    assrt.equal(v, Math.floor(v))
    if v > 2 ** 32:
        big = True
    v = randrange(-10 ** 12, 10 ** 12, 7)
    assrt.ok(-10 ** 12 <= v and v < 10 ** 12)
    assrt.equal((v + 10 ** 12) % 7, 0)
assrt.ok(big, 'randrange(10**12) never returned a value above 2**32')
assrt.throws(def (): randrange(0);, ValueError)
assrt.throws(def (): randrange(-3);, ValueError)
assrt.throws(def (): randrange(5, 5);, ValueError)
assrt.throws(def (): randrange(0, 10, 0);, ValueError)
assrt.throws(def (): randrange(1 / 0);, ValueError)
