# globals: assrt, RapydScript, require, compiler_dir, test_path

# Test tree shaking functionality
# Tree shaking removes unused top-level function and class definitions

shake_tree = require(compiler_dir + '/../tools/tree_shaking')

def parse_code(code):
    return RapydScript.parse(code, {'filename': 'test_tree_shaking.pyj'})

def get_names(ast):
    """Get all top-level definition names from the AST body."""
    names = []
    for node in ast.body:
        if node.name:
            names.push(node.name.name)
        elif node.body and node.body.left and node.body.left.name:
            names.push(node.body.left.name)
    return names

# Test 1: Unused function is removed
code = 'def used():\n    return 1\ndef unused():\n    return 2\nused()\n'
ast = parse_code(code)
shake_tree(ast)
names = get_names(ast)
assrt.ok(names.indexOf('used') != -1, 'used function should be kept')
assrt.ok(names.indexOf('unused') == -1, 'unused function should be removed')

# Test 2: Transitively used functions are kept
code = 'def helper():\n    return 42\ndef main_func():\n    return helper()\nmain_func()\n'
ast = parse_code(code)
shake_tree(ast)
names = get_names(ast)
assrt.ok(names.indexOf('helper') != -1, 'transitively used function should be kept')
assrt.ok(names.indexOf('main_func') != -1, 'directly called function should be kept')

# Test 3: Unused class is removed
code = 'class Used:\n    def __init__(self):\n        self.x = 1\nclass Unused:\n    def __init__(self):\n        self.y = 2\nUsed()\n'
ast = parse_code(code)
shake_tree(ast)
names = get_names(ast)
assrt.ok(names.indexOf('Used') != -1, 'used class should be kept')
assrt.ok(names.indexOf('Unused') == -1, 'unused class should be removed')

# Test 4: Parent class is kept when child is used (inheritance)
code = 'class Base:\n    def __init__(self):\n        self.x = 1\nclass Child(Base):\n    pass\nChild()\n'
ast = parse_code(code)
shake_tree(ast)
names = get_names(ast)
assrt.ok(names.indexOf('Base') != -1, 'parent class should be kept when child is used')
assrt.ok(names.indexOf('Child') != -1, 'used child class should be kept')

# Test 5: Unused variable assignment is removed
code = 'x = 5\ny = 10\ndef foo():\n    return x\nfoo()\n'
ast = parse_code(code)
shake_tree(ast)
names = get_names(ast)
assrt.ok(names.indexOf('x') != -1, 'used variable should be kept')
assrt.ok(names.indexOf('y') == -1, 'unused variable should be removed')
assrt.ok(names.indexOf('foo') != -1, 'used function should be kept')

# Test 6: All code kept when everything is used
code = 'def a():\n    return 1\ndef b():\n    return a()\ndef c():\n    return b()\nc()\n'
ast = parse_code(code)
original_len = ast.body.length
shake_tree(ast)
assrt.equal(ast.body.length, original_len, 'all nodes should be kept when all are used')

# Test 7: Multiple unused functions removed
code = 'def used1():\n    return 1\ndef unused1():\n    return 2\ndef unused2():\n    return 3\ndef used2():\n    return used1()\nused2()\n'
ast = parse_code(code)
shake_tree(ast)
names = get_names(ast)
assrt.ok(names.indexOf('used1') != -1, 'used1 should be kept')
assrt.ok(names.indexOf('used2') != -1, 'used2 should be kept')
assrt.ok(names.indexOf('unused1') == -1, 'unused1 should be removed')
assrt.ok(names.indexOf('unused2') == -1, 'unused2 should be removed')

# Test 8: Function used via another function's body reference
code = 'def helper():\n    return "help"\ndef wrapper():\n    return helper()\ndef caller():\n    return wrapper()\ncaller()\n'
ast = parse_code(code)
shake_tree(ast)
names = get_names(ast)
assrt.ok(names.indexOf('helper') != -1, 'deeply transitive helper should be kept')
assrt.ok(names.indexOf('wrapper') != -1, 'intermediate wrapper should be kept')
assrt.ok(names.indexOf('caller') != -1, 'top-level caller should be kept')

# Test 9: Non-definition statements are always preserved
code = 'def unused():\n    return 1\nprint("hello")\nx = 5\n'
ast = parse_code(code)
body_before = ast.body.length
shake_tree(ast)
# print("hello") is a non-definition, always kept
# x = 5 is a definition but is not used by any non-definition
# Actually print("hello") doesn't reference x, so x can be removed
# but print("hello") is not a definition so it stays
found_print = False
for node in ast.body:
    if node.constructor.name == 'AST_SimpleStatement':
        if node.body.constructor.name == 'AST_Call':
            found_print = True
assrt.ok(found_print, 'non-definition statements like function calls should be preserved')
names = get_names(ast)
assrt.ok(names.indexOf('unused') == -1, 'unused function should be removed even with other statements')

# Test 10: Empty body - no crash
code = '\n'
ast = parse_code(code)
shake_tree(ast)  # should not throw
assrt.ok(True, 'empty body should not cause errors')

# Test 11: Function that references itself (recursive) but is unused should be removed
code = 'def recursive(n):\n    if n <= 0:\n        return 0\n    return recursive(n - 1)\ndef used():\n    return 1\nused()\n'
ast = parse_code(code)
shake_tree(ast)
names = get_names(ast)
assrt.ok(names.indexOf('recursive') == -1, 'unused recursive function should be removed')
assrt.ok(names.indexOf('used') != -1, 'used function should be kept')

# Test 12: Class used as argument to a function call
code = 'class MyClass:\n    pass\nclass UnusedClass:\n    pass\ndef process(cls):\n    return cls()\nprocess(MyClass)\n'
ast = parse_code(code)
shake_tree(ast)
names = get_names(ast)
assrt.ok(names.indexOf('MyClass') != -1, 'class used as argument should be kept')
assrt.ok(names.indexOf('process') != -1, 'function that uses class should be kept')
assrt.ok(names.indexOf('UnusedClass') == -1, 'class not used anywhere should be removed')

# Test 13: Variable used in another variable definition
code = 'x = 10\ny = x + 5\nprint(y)\n'
ast = parse_code(code)
shake_tree(ast)
names = get_names(ast)
assrt.ok(names.indexOf('x') != -1, 'variable referenced by used variable should be kept')
assrt.ok(names.indexOf('y') != -1, 'variable used in print should be kept')

# Test 14: Decorator-like pattern - function passed to another
code = 'def decorator(f):\n    return f\ndef unused_decorator(f):\n    return f\ndef my_func():\n    return 1\nresult = decorator(my_func)\nprint(result)\n'
ast = parse_code(code)
shake_tree(ast)
names = get_names(ast)
assrt.ok(names.indexOf('decorator') != -1, 'used decorator should be kept')
assrt.ok(names.indexOf('my_func') != -1, 'function passed as argument should be kept')
assrt.ok(names.indexOf('unused_decorator') == -1, 'unused decorator should be removed')

# Test 15: Only definitions at top level are shaken, not nested ones
code = 'def outer():\n    def inner():\n        return 1\n    return inner()\nouter()\n'
ast = parse_code(code)
shake_tree(ast)
names = get_names(ast)
assrt.ok(names.indexOf('outer') != -1, 'outer function should be kept')
# inner is not a top-level definition, so it should not be affected
assrt.equal(ast.body.length, 2, 'body should have outer + the call statement')

# Test 16: Function used in a conditional expression
code = 'def get_value():\n    return 42\ndef unused_func():\n    return 0\nresult = get_value() if True else 0\nprint(result)\n'
ast = parse_code(code)
shake_tree(ast)
names = get_names(ast)
assrt.ok(names.indexOf('get_value') != -1, 'function in conditional should be kept')
assrt.ok(names.indexOf('unused_func') == -1, 'unused function should be removed')

# Test 17: Verify tree shaking doesn't break when there are no definitions
code = 'print("hello")\nprint("world")\n'
ast = parse_code(code)
original_len = ast.body.length
shake_tree(ast)
assrt.equal(ast.body.length, original_len, 'no definitions means nothing to shake')

# Test 18: Variable used inside a class that is used
code = 'DEFAULT_VAL = 99\nclass MyObj:\n    def __init__(self):\n        self.val = DEFAULT_VAL\nobj = MyObj()\nprint(obj.val)\n'
ast = parse_code(code)
shake_tree(ast)
names = get_names(ast)
assrt.ok(names.indexOf('DEFAULT_VAL') != -1, 'variable used inside used class should be kept')
assrt.ok(names.indexOf('MyObj') != -1, 'used class should be kept')

# =========================================================
# Tests for tree shaking of imported modules and stdlib
# =========================================================

path = require('path')

def parse_with_imports(code, basedir):
    if not basedir:
        basedir = test_path
    return RapydScript.parse(code, {
        'filename': path.join(basedir, 'test_shake.pyj'),
        'basedir': basedir,
        'libdir': path.join(compiler_dir, '..', 'src', 'lib'),
    })

def get_module_body_names(mod):
    """Get names defined in a module's body."""
    names = []
    if not mod or not mod.body:
        return names
    for node in mod.body:
        if node.name:
            names.push(node.name.name)
        elif node.body and node.body.left and node.body.left.name:
            names.push(node.body.left.name)
    return names

def get_module_export_names(mod):
    """Get exported names from a module."""
    if not mod or not mod.exports:
        return []
    return [e.name for e in mod.exports]

# Test 19: stdlib - from math import sin - only sin is kept
code = 'from math import sin, cos, factorial\nprint(sin(1.0))\n'
ast = parse_with_imports(code, None)
math_mod = ast.imports['math']
if math_mod and math_mod.body:
    # Only test if not cached (cached modules have no body to shake)
    original_body_len = math_mod.body.length
    shake_tree(ast)
    mod_names = get_module_body_names(math_mod)
    assrt.ok(mod_names.indexOf('sin') != -1, 'stdlib: used function sin should be kept')
    assrt.ok(mod_names.indexOf('cos') == -1, 'stdlib: unused imported cos should be removed')
    assrt.ok(mod_names.indexOf('factorial') == -1, 'stdlib: unused imported factorial should be removed')
    assrt.ok(math_mod.body.length < original_body_len, 'stdlib: body should be smaller after shaking')

# Test 20: stdlib - import math, use math.sin and math.cos
code = 'import math\nx = math.sin(1.0) + math.cos(0.5)\nprint(x)\n'
ast = parse_with_imports(code, None)
math_mod = ast.imports['math']
if math_mod and math_mod.body:
    shake_tree(ast)
    mod_names = get_module_body_names(math_mod)
    assrt.ok(mod_names.indexOf('sin') != -1, 'stdlib full import: sin should be kept')
    assrt.ok(mod_names.indexOf('cos') != -1, 'stdlib full import: cos should be kept')
    assrt.ok(mod_names.indexOf('factorial') == -1, 'stdlib full import: unused factorial should be removed')
    assrt.ok(mod_names.indexOf('floor') == -1, 'stdlib full import: unused floor should be removed')

# Test 21: stdlib - transitive dependency in stdlib module
# math.factorial doesn't depend on anything else in math, but let's test
# a case where one function might use another
code = 'from math import factorial\nprint(factorial(5))\n'
ast = parse_with_imports(code, None)
math_mod = ast.imports['math']
if math_mod and math_mod.body:
    shake_tree(ast)
    mod_names = get_module_body_names(math_mod)
    assrt.ok(mod_names.indexOf('factorial') != -1, 'stdlib: used factorial should be kept')
    assrt.ok(mod_names.indexOf('sin') == -1, 'stdlib: unrelated sin should be removed')

# Test 22: User module - only imported and used names are kept
code = 'from _import_one import toplevel_func\ntoplevel_func("hello")\n'
ast = parse_with_imports(code, None)
imp_one = ast.imports['_import_one']
if imp_one and imp_one.body:
    original_exports = get_module_export_names(imp_one).length
    shake_tree(ast)
    mod_names = get_module_body_names(imp_one)
    assrt.ok(mod_names.indexOf('toplevel_func') != -1, 'user module: used function should be kept')
    # AClass and TopLevel are not imported/used, should be removed
    assrt.ok(mod_names.indexOf('AClass') == -1, 'user module: unused class AClass should be removed')
    assrt.ok(mod_names.indexOf('TopLevel') == -1, 'user module: unused class TopLevel should be removed')

# Test 23: User module - class with parent, parent kept when child is used
code = 'from _import_one import AClass\nobj = AClass("test")\n'
ast = parse_with_imports(code, None)
imp_one = ast.imports['_import_one']
if imp_one and imp_one.body:
    shake_tree(ast)
    mod_names = get_module_body_names(imp_one)
    assrt.ok(mod_names.indexOf('AClass') != -1, 'user module: used AClass should be kept')
    assrt.ok(mod_names.indexOf('TopLevel') != -1, 'user module: parent TopLevel should be kept when AClass is used')
    assrt.ok(mod_names.indexOf('toplevel_func') == -1, 'user module: unused toplevel_func should be removed')

# Test 24: Cached modules are gracefully skipped (no crash)
# Force a parse that might produce cached modules, then shake
code = 'from math import sin\nprint(sin(0.5))\n'
ast = parse_with_imports(code, None)
math_mod = ast.imports['math']
if math_mod and math_mod.is_cached:
    # Should not crash on cached modules
    shake_tree(ast)
    assrt.ok(True, 'cached modules should be gracefully skipped without crash')

# Test 25: Multiple modules - each is shaken independently
code = 'from _import_one import toplevel_func\nfrom _import_two import toplevel_func2\ntoplevel_func("x")\n'
ast = parse_with_imports(code, None)
imp_one = ast.imports['_import_one']
imp_two = ast.imports['_import_two']
if imp_one and imp_one.body and imp_two and imp_two.body:
    shake_tree(ast)
    one_names = get_module_body_names(imp_one)
    two_names = get_module_body_names(imp_two)
    assrt.ok(one_names.indexOf('toplevel_func') != -1, 'multi-module: used func in module 1 kept')
    # toplevel_func2 is imported but not used
    assrt.ok(two_names.indexOf('toplevel_func2') == -1, 'multi-module: imported but unused func in module 2 removed')

# Test 26: from module import with alias - alias is what's referenced
code = 'from _import_one import toplevel_func as tf\ntf("y")\n'
ast = parse_with_imports(code, None)
imp_one = ast.imports['_import_one']
if imp_one and imp_one.body:
    shake_tree(ast)
    mod_names = get_module_body_names(imp_one)
    assrt.ok(mod_names.indexOf('toplevel_func') != -1, 'aliased import: original name should be kept when alias is used')

# Test 27: stdlib - export list is also trimmed
code = 'from math import sin\nprint(sin(0.5))\n'
ast = parse_with_imports(code, None)
math_mod = ast.imports['math']
if math_mod and math_mod.body:
    shake_tree(ast)
    export_names = get_module_export_names(math_mod)
    assrt.ok(export_names.indexOf('sin') != -1, 'stdlib exports: sin should remain in exports')
    assrt.ok(export_names.indexOf('cos') == -1, 'stdlib exports: unused cos should be removed from exports')
    assrt.ok(export_names.indexOf('factorial') == -1, 'stdlib exports: unused factorial should be removed from exports')

# Test 28: User module nonlocalvars and conditionals (non-definitions) are preserved
code = 'from _import_one import toplevel_func\ntoplevel_func("z")\n'
ast = parse_with_imports(code, None)
imp_one = ast.imports['_import_one']
if imp_one and imp_one.body:
    shake_tree(ast)
    # Non-definition statements like AST_If, AST_Var, AST_Imports should be kept
    non_def_types = []
    for node in imp_one.body:
        cname = node.constructor.name
        if cname != 'AST_Function' and cname != 'AST_Class':
            if not (cname == 'AST_SimpleStatement' and node.body and node.body.constructor.name == 'AST_Assign'):
                non_def_types.push(cname)
    assrt.ok(non_def_types.length > 0, 'user module: non-definition statements should be preserved')

