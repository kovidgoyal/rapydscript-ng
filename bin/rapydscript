#!/usr/bin/env node
// vim:ft=javascript:ts=4:et

import { fileURLToPath } from 'url';
import path from 'path';
import { spawn } from 'child_process';
import * as utils from '../tools/utils.mjs';
import { create_compiler } from '../tools/compiler.mjs';

const __filename = fileURLToPath(import.meta.url);

globalThis.create_rapydscript_compiler = create_compiler;

var start_time = new Date().getTime();

var { argv } = await import('../tools/cli.mjs');

var base_path = path.normalize(path.join(path.dirname(__filename), ".."));
var src_path = path.join(base_path, 'src');
var lib_path = path.join(base_path, 'dev');
if (!utils.path_exists(path.join(lib_path, 'compiler.js'))) lib_path = path.join(base_path, 'release');

if (argv.mode === 'self') {
    if (argv.files.length > 0) {
        console.error("WARN: Ignoring input files since --self was passed");
    }
    (await import('../tools/self.mjs')).default(base_path, src_path, lib_path, argv.complete, argv.profile);
    if (argv.test) {
        console.log('\nRunning test suite...\n');
        argv.files = [];  // Ensure all tests are run
        (await import('../tools/test.mjs')).default(argv, base_path, src_path, path.join(base_path, 'dev'));
    }
    process.exit(0);
} else

if (argv.mode === 'test') {
    (await import('../tools/test.mjs')).default(argv, base_path, src_path, lib_path);
} else

if (argv.mode === 'lint') {
    (await import('../tools/lint.mjs')).cli(argv, base_path, src_path, lib_path);
} else

if (argv.mode === 'repl') {
    (await import('../tools/repl.mjs')).default({'lib_path':lib_path, 'imp_path':path.join(src_path, 'lib'), show_js:!argv.no_js});
} else

if (argv.mode === 'gettext') {
    (await import('../tools/gettext.mjs')).cli(argv, base_path, src_path, lib_path);
} else

if (argv.mode === 'msgfmt') {
    (await import('../tools/msgfmt.mjs')).cli(argv, base_path, src_path, lib_path);
} else

if (argv.mode === 'export') {
    (await import('../tools/export_cmd.mjs')).default(base_path, lib_path);
} else

if (argv.mode === 'web-repl-export') {
    (await import('../tools/web_repl_export.mjs')).default(base_path, lib_path, argv);
} else

{
    (await import('../tools/compile.mjs')).default(start_time, argv, base_path, src_path, lib_path);
}
